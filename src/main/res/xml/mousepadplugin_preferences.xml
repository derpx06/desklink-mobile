<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:keep="@xml/mousepadplugin_preferences">

    <PreferenceCategory android:title="@string/remote_prefs_screen_category">

        <ListPreference
            android:defaultValue="touch"
            android:entries="@array/remote_mode_entries"
            android:entryValues="@array/remote_mode_values"
            android:key="@string/remote_pref_default_mode"
            android:summary="%s"
            android:title="@string/remote_pref_default_mode_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/remote_pref_edge_to_edge"
            android:title="@string/remote_pref_edge_to_edge_title"
            android:summary="@string/remote_pref_edge_to_edge_summary" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/remote_pref_auto_keyboard"
            android:title="@string/remote_pref_auto_keyboard_title"
            android:summary="@string/remote_pref_auto_keyboard_summary" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/remote_pref_autohide_controls"
            android:title="@string/remote_pref_autohide_controls_title"
            android:summary="@string/remote_pref_autohide_controls_summary" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/remote_pref_keep_screen_on"
            android:title="@string/remote_pref_keep_screen_on_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/remote_pref_haptics"
            android:title="@string/remote_pref_haptics_title"
            android:summary="@string/remote_pref_haptics_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/remote_prefs_scroll_category">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/mousepad_scroll_direction"
            android:title="@string/mousepad_scroll_direction_title" />

        <SeekBarPreference
            android:defaultValue="100"
            android:max="300"
            app:min="25"
            app:showSeekBarValue="true"
            android:key="@string/mousepad_scroll_sensitivity"
            android:title="@string/mousepad_scroll_sensitivity_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/remote_prefs_trackpad_category">

        <ListPreference
            android:defaultValue="@string/mousepad_default_sensitivity"
            android:entries="@array/mousepad_sensitivity_entries"
            android:entryValues="@array/mousepad_sensitivity_values"
            android:key="@string/mousepad_sensitivity_key"
            android:summary="%s"
            android:title="@string/mousepad_sensitivity_settings_title" />

        <ListPreference
            android:defaultValue="@string/mousepad_default_acceleration_profile"
            android:entries="@array/mousepad_acceleration_profile_entries"
            android:entryValues="@array/mousepad_acceleration_profile_values"
            android:key="@string/mousepad_acceleration_profile_key"
            android:summary="%s"
            android:title="@string/mousepad_acceleration_profile_settings_title" />
    </PreferenceCategory>

    <org.desklink.mobile.helpers.LongSummaryPreferenceCategory
        android:key="@string/sendkeystrokes_pref_category"
        android:summary="@string/sendkeystrokes_pref_category_summary"
        android:title="@string/sendkeystrokes_pref_category_title">

        <SwitchPreference
            android:id="@+id/pref_keystrokes_enable"
            android:defaultValue="true"
            android:key="@string/pref_sendkeystrokes_enabled"
            android:title="@string/sendkeystrokes_pref_enabled"
            android:summary="@string/sendkeystrokes_pref_enabled_summary"
            />

        <SwitchPreference
            android:id="@+id/pref_send_safe_text_immediately"
            android:defaultValue="true"
            android:key="@string/pref_send_safe_text_immediately"
            android:title="@string/sendkeystrokes_safe_text_enabled"
            android:summary="@string/sendkeystrokes_safe_text_enabled_summary"
            />

    </org.desklink.mobile.helpers.LongSummaryPreferenceCategory>

</PreferenceScreen>
