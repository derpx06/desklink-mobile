<?xml version="1.0" encoding="utf-8"?>
<!-- Notes: 2x2 up to 4x4. Redrawn on every change; the period is only the system's safety net against a picture left by a killed process. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_notes_description"
    android:initialLayout="@layout/widget_notes"
    android:maxResizeHeight="320dp"
    android:maxResizeWidth="320dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_notes_preview"
    android:previewLayout="@layout/widget_notes"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
