<?xml version="1.0" encoding="utf-8"?>
<!-- Quick actions: 4x1 or 4x2. Redrawn on every change; the period is only the system's safety net against a picture left by a killed process. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_actions_description"
    android:initialLayout="@layout/widget_actions_small"
    android:maxResizeHeight="180dp"
    android:maxResizeWidth="320dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="250dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_actions_preview"
    android:previewLayout="@layout/widget_actions_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
