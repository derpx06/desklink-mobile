<?xml version="1.0" encoding="utf-8"?>
<!-- The round tonal buttons (Lock only when the computer allows it), shared by the 4x1 and 4x2 quick actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/act_screen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/act_screen_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/sym_desktop_windows"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/act_screen_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/home_desk_screen"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/act_files"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/act_files_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/sym_upload_file"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/act_files_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/home_send_files"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/act_clipboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/act_clipboard_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/sym_content_paste"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/act_clipboard_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_clipboard"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/act_ring"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/act_ring_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/sym_vibration"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/act_ring_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_ring"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/act_lock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/act_lock_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_tonal_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/sym_lock"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/act_lock_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_lock"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
