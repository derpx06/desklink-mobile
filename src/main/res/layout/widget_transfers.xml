<?xml version="1.0" encoding="utf-8"?>
<!-- Transfers, 4x1: the running transfer with its direction, computer and progress, else the last one; the Bucket's size
     beside it. File names are cut in the middle so the extension stays. The whole widget opens Files. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_desk_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/t_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_icon_square"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:src="@drawable/sym_upload_file"
        android:tint="@color/widget_on_tonal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/t_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_transfers_preview_name"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_bucket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_transfers_preview_bucket"
                android:textColor="@color/widget_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/t_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_transfers_preview_sub"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/t_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progress="42"
            android:progressDrawable="@drawable/widget_progress"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
