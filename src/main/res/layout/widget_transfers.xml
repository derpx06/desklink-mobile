<?xml version="1.0" encoding="utf-8"?>
<!-- Transfers, 4x1: the running transfer with its progress, else the last one; the Bucket's size under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_desk_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/t_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_tonal_circle"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/sym_upload_file"
        android:tint="@color/widget_on_tonal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/t_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="@string/widget_transfers_preview_name"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/t_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_transfers_preview_sub"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/t_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="42"
            android:progressDrawable="@drawable/widget_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/t_bucket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_transfers_preview_bucket"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
