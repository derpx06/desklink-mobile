<?xml version="1.0" encoding="utf-8"?>
<!-- New terminal, 2x1 to 4x1: one big target. The terminal icon, "New terminal" (or why not), and the computer with its
     state as a dot plus words. Never hidden: when it cannot start one, it is dimmed and a tap says why. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_desk_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/term_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_square"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/sym_terminal"
        android:tint="@color/widget_on_tonal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <TextView
            android:id="@+id/term_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_terminals_new"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/term_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_mint" />

            <TextView
                android:id="@+id/term_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_desk_preview_name"
                android:textColor="@color/widget_text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
