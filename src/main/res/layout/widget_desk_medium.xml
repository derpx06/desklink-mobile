<?xml version="1.0" encoding="utf-8"?>
<!-- DeskLink widget, 2x2 with room for two rows: the computer and its state, Lock, Send clipboard, Ring and Terminals (with the "finished" badge). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_desk_background"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="8dp">

    <include layout="@layout/widget_part_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:gravity="center"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/widget_lock_icon"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_chip"
                android:importantForAccessibility="no"
                android:paddingStart="13dp"
                android:paddingTop="5dp"
                android:paddingEnd="13dp"
                android:paddingBottom="5dp"
                android:src="@drawable/sym_lock"
                android:tint="@color/widget_on_tonal" />

            <TextView
                android:id="@+id/widget_lock_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_lock"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_clipboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:gravity="center"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/widget_clipboard_icon"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_chip"
                android:importantForAccessibility="no"
                android:paddingStart="13dp"
                android:paddingTop="5dp"
                android:paddingEnd="13dp"
                android:paddingBottom="5dp"
                android:src="@drawable/sym_content_paste"
                android:tint="@color/widget_on_tonal" />

            <TextView
                android:id="@+id/widget_clipboard_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_clipboard"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_ring"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:gravity="center"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/widget_ring_icon"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_chip"
                android:importantForAccessibility="no"
                android:paddingStart="13dp"
                android:paddingTop="5dp"
                android:paddingEnd="13dp"
                android:paddingBottom="5dp"
                android:src="@drawable/sym_vibration"
                android:tint="@color/widget_on_tonal" />

            <TextView
                android:id="@+id/widget_ring_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_ring"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_terminals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:gravity="center"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no">

                <ImageView
                android:id="@+id/widget_terminals_icon"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_chip"
                android:importantForAccessibility="no"
                android:paddingStart="13dp"
                android:paddingTop="5dp"
                android:paddingEnd="13dp"
                android:paddingBottom="5dp"
                android:src="@drawable/sym_terminal"
                android:tint="@color/widget_on_tonal" />

                <TextView
                    android:id="@+id/widget_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/widget_badge"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/widget_on_coral"
                    android:textSize="11dp"
                    tools:ignore="SpUsage"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_terminals_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_terminals"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
