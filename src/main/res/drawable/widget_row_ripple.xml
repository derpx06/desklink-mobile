<?xml version="1.0" encoding="utf-8"?>
<!-- A whole tappable area (action, row, header): no fill, a ripple clipped to the launcher's inner radius. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
