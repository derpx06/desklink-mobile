<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Termux's emulator/renderer declare minSdk 24 but use no API above 23 (verified by
         source audit); the app supports 23. The PTY JNI part is excluded, see build.gradle.kts. -->
    <uses-sdk tools:overrideLibrary="com.termux.terminal,com.termux.view" />

    <!-- SpeechRecognizer.isRecognitionAvailable sees no recognizer on Android 11+ without this:
         the terminal's dictation key would never show. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The notification filter lists, and notifications name, launchable apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- F5: "Message" from the desk opens the messaging app's compose screen. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for any LAN traffic once targetSdk reaches 37 (Android 17);
         ignored by older releases. Declared now so the upgrade can't silently
         cut discovery, the TLS link and WebRTC host candidates. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Calls on the computer (off by default): answer/hang up, dial, and caller names. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- "Phone as webcam" (C4): the camera service, started only from a visible DeskLink window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- F1: the phone's microphone for the desk, started only from a visible DeskLink window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calls: mute the microphone on the desk's request (setMicrophoneMute needs it). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- F7: an automation's "Do Not Disturb" and silent ringer (granted in Settings), and "Write tag". -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:banner="@drawable/desklink_banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/DeskLinkTheme.NoActionBar"
        android:name="org.desklink.mobile.DeskLinkApplication"
        android:enableOnBackInvokedCallback="true">

        <service
            android:name="org.desklink.mobile.BackgroundService"
            android:foregroundServiceType="connectedDevice"
            android:icon="@drawable/desklink_mark"
            android:enabled="true" />
        <service
            android:name="org.desklink.mobile.plugins.screen.PhoneScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name="org.desklink.mobile.plugins.camera.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
        <!-- F1: this phone's microphone or sound while a desk hears it. -->
        <service
            android:name="org.desklink.mobile.plugins.audio.PhoneAudioService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />
        <activity
            android:name="org.desklink.mobile.plugins.audio.PhoneAudioActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent" />
        <activity
            android:name="org.desklink.mobile.plugins.mousereceiver.AccessibilitySetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent" />
        <!-- F3 "Insert from phone": the photo, scan, text or QR code a desk asked for. -->
        <activity
            android:name="org.desklink.mobile.plugins.capture.CaptureActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:taskAffinity="" />
        <!-- "<desk> wants to use this phone's camera": asked once per desk, then remembered. -->
        <activity
            android:name="org.desklink.mobile.plugins.camera.CameraConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent" />
        <service
            android:name="org.desklink.mobile.plugins.remotekeyboard.RemoteKeyboardService"
            android:label="@string/remote_keyboard_service"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/remotekeyboardplugin_method" />
        </service>

        <activity
            android:name="org.desklink.mobile.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.screen.ScreenProjectionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />
        <activity
            android:name="org.desklink.mobile.ui.PluginSettingsActivity"
            android:label="@string/device_menu_plugins"
            android:exported="false"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.ui.CustomDevicesActivity"
            android:label="@string/custom_devices_settings"
            android:exported="false"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.share.SendFileActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>

        <receiver
            android:name="org.desklink.mobile.plugins.mousereceiver.TypeOnPhoneAllowReceiver"
            android:exported="false" />
        <receiver android:name="org.desklink.mobile.DeskLinkBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="org.desklink.mobile.plugins.findmyphone.FindMyPhoneActivity"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true"
            android:label="@string/findmyphone_title"
            android:launchMode="singleInstance" />

        <!-- End on the coral live-session notification. Not exported. -->
        <receiver
            android:name="org.desklink.mobile.plugins.screen.SessionLiveNotification$EndReceiver"
            android:exported="false" />

        <!-- "Unlock <desk>?": a sheet over the current screen, shown over the lock screen too. -->
        <activity
            android:name="org.desklink.mobile.plugins.deskunlock.UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/DeskLinkTheme.Sheet" />

        <receiver
            android:name="org.desklink.mobile.plugins.handoff.HandoffPlugin$DismissReceiver"
            android:exported="false" />

        <!-- "Copy" on "Open link from <desk>". -->
        <receiver
            android:name="org.desklink.mobile.plugins.share.LinkFromDesk$CopyReceiver"
            android:exported="false" />

        <!-- A desk notification swiped away on the phone: closed on the desk too. -->
        <receiver
            android:name="org.desklink.mobile.plugins.receivenotifications.ReceiveNotificationsPlugin$DismissReceiver"
            android:exported="false" />

        <!-- Pairing notification actions. Not exported: no other app may accept or reject a pairing. -->
        <receiver
            android:name="org.desklink.mobile.PairingActionReceiver"
            android:exported="false" />

        <receiver android:name="org.desklink.mobile.plugins.findmyphone.FindMyPhoneReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.desklink.mobile.plugins.findmyphone.foundIt" />
            </intent-filter>
        </receiver>

        <!-- Plugin-related activities and services -->

        <activity
            android:name="org.desklink.mobile.plugins.clipboard.ClipboardFloatingActivity"
            android:theme="@style/Theme.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true"/>

        <activity
            android:name="org.desklink.mobile.plugins.mpris.MprisActivity"
            android:label="@string/open_mpris_controls"
            android:launchMode="singleTop"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>

        <receiver android:name="org.desklink.mobile.plugins.mpris.MprisMediaNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <activity
            android:name="org.desklink.mobile.plugins.runcommand.RunCommandActivity"
            android:label="@string/pref_plugin_runcommand"
            android:exported="false"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.runcommand.RunCommandWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:label="@string/pref_plugin_runcommand"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="user"/>

        <service
            android:name="org.desklink.mobile.plugins.runcommand.CommandsRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name="org.desklink.mobile.plugins.runcommand.RunCommandWidgetProvider"
            android:label="@string/pref_plugin_runcommand"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remotecommandplugin_widget" />
        </receiver>

        <!--
            Not exported: it runs commands on the paired desktop, and it is
            reached only through a PendingIntent this application creates
            itself. See RunCommandWidgetActionReceiver.
        -->
        <receiver
            android:name="org.desklink.mobile.plugins.runcommand.RunCommandWidgetActionReceiver"
            android:exported="false" />

        <activity android:name="org.desklink.mobile.plugins.runcommand.RunCommandUrlActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="runcommand"
                    android:scheme="kdeconnect" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.mousepad.BigscreenActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/pref_plugin_bigscreen"
            android:exported="true"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.mousepad.MousePadActivity"
            android:label="@string/pref_plugin_mousepad"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:launchMode="singleTop"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.terminal.TerminalActivity"
            android:label="@string/terminal_title"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <receiver
            android:name="org.desklink.mobile.plugins.terminal.TerminalAttentionReceiver"
            android:exported="false" />
        <!-- F8b: the Bucket; "DeskLink Bucket" in the share sheet for any file, text or link. -->
        <activity
            android:name="org.desklink.mobile.plugins.folders.BucketActivity"
            android:label="@string/bucket_title"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity-alias
            android:name="org.desklink.mobile.plugins.folders.ShareToBucketActivity"
            android:label="@string/bucket_share_label"
            android:targetActivity="org.desklink.mobile.plugins.folders.BucketActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <!-- F7: automations. -->
        <receiver
            android:name="org.desklink.mobile.plugins.automations.AutomationAlarms$Receiver"
            android:exported="false" />
        <activity
            android:name="org.desklink.mobile.plugins.automations.AutomationsActivity"
            android:label="@string/automations_title"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- F6: notes and snippets; "Save to DeskLink notes" in the share sheet. -->
        <activity
            android:name="org.desklink.mobile.plugins.notes.NotesActivity"
            android:label="@string/notes_title"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name="org.desklink.mobile.plugins.notes.SaveToNotesActivity"
            android:label="@string/notes_share_label"
            android:targetActivity="org.desklink.mobile.plugins.notes.NotesActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name="org.desklink.mobile.plugins.mousepad.ComposeSendActivity"
            android:label="@string/compose_send_title"
            android:exported="false"
            android:parentActivityName="org.desklink.mobile.plugins.mousepad.MousePadActivity"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.plugins.mousepad.MousePadActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.mousepad.SendKeystrokesToHostActivity"
            android:label="@string/pref_plugin_mousepad_send_keystrokes"
            android:exported="true"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/x-keystrokes"/>
            </intent-filter>
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.presenter.PresenterActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/pref_plugin_presenter"
            android:exported="false"
            android:parentActivityName="org.desklink.mobile.ui.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.MainActivity" />
        </activity>
        <activity
            android:name="org.desklink.mobile.plugins.share.ShareActivity"
            android:exported="true"
            android:label="@string/manifest_label_share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <meta-data
                android:name="android.service.chooser.chooser_target_service"
                android:value="org.desklink.mobile.plugins.share.ShareChooserTargetService" />
        </activity>

        <!-- "Open on computer" in the share sheet: a link shared here opens on the desk (C3). -->
        <activity-alias
            android:name="org.desklink.mobile.plugins.share.OpenOnDesk"
            android:exported="true"
            android:icon="@drawable/sym_open_in_new"
            android:label="@string/open_on_desk"
            android:targetActivity="org.desklink.mobile.plugins.share.ShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <receiver android:name="org.desklink.mobile.plugins.share.ShareBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.desklink.mobile.plugins.share.CancelShare" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fileprovider_paths" />
        </provider>

        <service
            android:name="org.desklink.mobile.plugins.notifications.NotificationReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name="org.desklink.mobile.plugins.share.ShareChooserTargetService"
            android:exported="true"
            android:permission="android.permission.BIND_CHOOSER_TARGET_SERVICE">
            <intent-filter>
                <action android:name="android.service.chooser.ChooserTargetService" />
            </intent-filter>
        </service>
        <service
            android:name="org.desklink.mobile.plugins.mousereceiver.MouseReceiverService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mouse_receiver_service" />
        </service>

        <activity
            android:name="org.desklink.mobile.plugins.notifications.NotificationFilterActivity"
            android:label="@string/title_activity_notification_filter"
            android:parentActivityName="org.desklink.mobile.ui.PluginSettingsActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.desklink.mobile.ui.PluginSettingsActivity" />
        </activity>

        <activity
            android:name="org.desklink.mobile.plugins.digitizer.DigitizerActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/pref_plugin_digitizer"
            android:exported="false"
            android:launchMode="singleTop"
