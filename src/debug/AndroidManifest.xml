<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- The "Automatic clipboard sync (advanced)" workaround reads the system log for the clipboard refusal and draws a 1 px
         window to gain focus. It circumvents Android 10's clipboard rule and Google Play rejects both permissions, so only
         builds installed by hand (debug) declare them; release builds have no such switch. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <activity
            android:name="org.desklink.mobile.QuitActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- The Home media card with made-up tracks, for the screenshot matrix. -->
        <activity
            android:name="org.desklink.mobile.ui.compose.screen.home.MediaCardPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <!-- F1 negotiation and idle-audio check with real libwebrtc, in-process. -->
        <activity
            android:name="org.desklink.mobile.webrtc.AudioSelfTestActivity"
            android:exported="true" />
        <!-- F3: a made-up capture request, for screenshots. -->
        <activity
            android:name="org.desklink.mobile.plugins.capture.CaptureDemoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
